# Normalizar fines de linea a LF en el repositorio
* text=auto

# Scripts: LF para Bash, CRLF para PowerShell
*.sh text eol=lf
*.ps1 text eol=crlf

# Binarios de documentos y medios
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary
*.xlsx binary
*.xlsm binary
*.pptx binary

# Lo copiado de terceros no cuenta como lenguaje del repo
skills/api-claude/** linguist-vendored=true
skills/constructor-mcp/reference/** linguist-vendored=true
skills/constructor-mcp/scripts/** linguist-vendored=true
skills/pdf/scripts/** linguist-vendored=true
skills/pptx/scripts/** linguist-vendored=true
skills/xlsx/scripts/** linguist-vendored=true
skills/pptx/package-lock.json linguist-vendored=true
*.xsd linguist-vendored=true
