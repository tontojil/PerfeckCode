{
  "$schema": "https://opencode.ai/config.json",
  // Formato automatico despues de editar (patron oh-my-opencode).
  "formatter": true,
  // Defensa en profundidad: secretos piden confirmacion antes de abrir.
  "permission": {
    "read": {
      "**/.env*": "ask",
      "**/secrets/**": "ask",
      "**/credentials.json": "ask",
      // Llaves privadas y config de editor con tokens: preguntan, no pasan directo.
      "**/*.pem": "ask",
      "**/*.key": "ask",
      "**/*.p12": "ask",
      "**/*.pfx": "ask",
      "**/id_rsa*": "ask",
      "**/id_ed25519*": "ask",
      "**/settings.json": "ask"
    },
    "edit": {
      "**/.env*": "ask",
      "**/secrets/**": "ask",
      "**/credentials.json": "ask",
      // Llaves privadas y config de editor con tokens: preguntan, no pasan directo.
      "**/*.pem": "ask",
      "**/*.key": "ask",
      "**/*.p12": "ask",
      "**/*.pfx": "ask",
      "**/id_rsa*": "ask",
      "**/id_ed25519*": "ask",
      "**/settings.json": "ask"
    },
    // Solo comandos seguros por defecto, instalacion con confirmacion, destructivos denegados.
    "bash": {
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm ci": "allow",
      "npm audit": "allow",
      "npm install": "ask",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}