{
  "$schema": "https://opencode.ai/config.json",
  // Formato automatico despues de editar (patron oh-my-opencode).
  "formatter": true,
  // Defensa en profundidad: secretos nunca legibles ni editables.
  "permission": {
    "read": {
      "**/.env*": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny"
    },
    "edit": {
      "**/.env*": "deny",
      "**/secrets/**": "deny",
      "**/credentials.json": "deny"
    }
  }
}