{
  "$schema": "https://opencode.ai/config.json",
  // Formato automático después de editar (patrón oh-my-opencode).
  "formatter": true,
  // Tono: español neutro y normal en todas las respuestas.
  // Esta instrucción garantiza que el cambio queda aplicado aunque AGENTS.md no se cargue.
  "instructions": [
    "Habla en español neutro, claro y normal en todas las respuestas. Usa oraciones completas y buena redacción. Ver opencode/AGENTS.md para las reglas completas."
  ],
  // Defensa en profundidad: secretos piden confirmación antes de abrir.
  "permission": {
    "read": {
      "**/.env*": "ask",
      "**/secrets/**": "ask",
      "**/credentials.json": "ask",
      // Llaves privadas y configuración de editor con tokens: preguntan, no pasan directo.
      "**/*.pem": "ask",
      "**/*.key": "ask",
      "**/*.p12": "ask",
      "**/*.pfx": "ask",
      "**/id_rsa*": "ask",
      "**/id_ed25519*": "ask",
      "**/settings.json": "ask"
    },
    "edit": {
      "**/.env*": "ask",
      "**/secrets/**": "ask",
      "**/credentials.json": "ask",
      // Llaves privadas y configuración de editor con tokens: preguntan, no pasan directo.
      "**/*.pem": "ask",
      "**/*.key": "ask",
      "**/*.p12": "ask",
      "**/*.pfx": "ask",
      "**/id_rsa*": "ask",
      "**/id_ed25519*": "ask",
      "**/settings.json": "ask"
    },
    "skill": {
      "*": "allow"
    },
    // Solo comandos seguros por defecto, instalación con confirmación, destructivos denegados.
    "bash": {
      "git status": "allow",
      "git diff*": "allow",
      "git log*": "allow",
      "npm ci": "allow",
      "npm audit": "allow",
      "npm install": "ask",
      "python *": "allow",
      "python -m markitdown*": "allow",
      "pandoc *": "allow",
      "rm -rf *": "deny",
      "sudo *": "deny"
    }
  }
}
